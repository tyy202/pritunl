# Pritunl Docker Environment Configuration
# Copy this file to .env and adjust values as needed

# MongoDB connection URI
# Format: mongodb://[username:password@]host:port/database
PRITUNL_MONGODB_URI=mongodb://mongodb:27017/pritunl

# Redis connection URI (optional)
PRITUNL_REDIS_URI=redis://redis:6379/0

# Configuration file path (default: /etc/pritunl.conf)
# PRITUNL_CONF=/etc/pritunl.conf
